# Google Cloud / Gemini (Vertex AI)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GEMINI_MODEL=gemini-2.5-pro

# Fallback: Gemini API via AI Studio (if Vertex quota runs out during demo)
GEMINI_API_KEY=

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
# Path to Firebase admin SDK service account JSON (often same as GOOGLE_APPLICATION_CREDENTIALS)
FIREBASE_CREDENTIALS=./service-account.json

# App config
ENVIRONMENT=development
MAX_PDF_SIZE_MB=20
AGENT_TIMEOUT_SECONDS=120
USE_MOCK_DATA=true
LOG_LEVEL=INFO

# CORS — comma separated origins for mobile dev
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://
